                C     LIVERMORE LOOP 5, TRI-DIAGONAL ELIMINATION (A RECURRENCE)
   ISN 0002           REAL*8 X(1001),Y(1001),Z(1001),S
   ISN 0003           DATA NREP/200000/
   ISN 0004           N=1000
   ISN 0005           DO 10 I=1,1001
   ISN 0006           Y(I)=1.0D0+DFLOAT(I)*1.0D-3
   ISN 0007        10 Z(I)=0.5D0
   ISN 0008           X(1)=0.0D0
   ISN 0009           DO 30 IR=1,NREP
   ISN 0010           DO 20 I=2,N
   ISN 0011        20 X(I)=Z(I)*(Y(I)-X(I-1))
   ISN 0012        30 CONTINUE
   ISN 0013           S=0.0D0
   ISN 0014           DO 40 I=1,N
   ISN 0015        40 S=S+X(I)
   ISN 0016           WRITE(6,100) S
   ISN 0017       100 FORMAT(' LLL5 CHECKSUM ',D22.15)
   ISN 0018           STOP
   ISN 0019           END
