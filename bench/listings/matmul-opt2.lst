                C     MATRIX MULTIPLY C = C + A*B, N=100, J-K-I ORDER, NREP TIMES
   ISN 0002           REAL*8 A(100,100),B(100,100),C(100,100),T,S
   ISN 0003           DATA NREP/200/
   ISN 0004           N=100
   ISN 0005           DO 10 J=1,N
   ISN 0006           DO 10 I=1,N
   ISN 0007           A(I,J)=DFLOAT(I+J)*1.0D-2
   ISN 0008           B(I,J)=DFLOAT(I-J)*1.0D-2
   ISN 0009        10 C(I,J)=0.0D0
   ISN 0010           DO 40 IR=1,NREP
   ISN 0011           DO 30 J=1,N
   ISN 0012           DO 30 K=1,N
   ISN 0013           T=B(K,J)
   ISN 0014           DO 20 I=1,N
   ISN 0015        20 C(I,J)=C(I,J)+A(I,K)*T
   ISN 0016        30 CONTINUE
   ISN 0017        40 CONTINUE
   ISN 0018           S=0.0D0
   ISN 0019           DO 50 J=1,N
   ISN 0020           DO 50 I=1,N
   ISN 0021        50 S=S+C(I,J)
   ISN 0022           WRITE(6,100) S
   ISN 0023       100 FORMAT(' MATMUL CHECKSUM ',D22.15)
   ISN 0024           STOP
   ISN 0025           END
