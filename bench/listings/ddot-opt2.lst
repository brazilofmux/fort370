                C     DDOT KERNEL: S = S + X*Y, N=1000, NREP TIMES
   ISN 0002           REAL*8 X(1000),Y(1000),S
   ISN 0003           DATA NREP/200000/
   ISN 0004           N=1000
   ISN 0005           DO 10 I=1,N
   ISN 0006           X(I)=DFLOAT(I)*1.0D-3
   ISN 0007        10 Y(I)=1.0D0/DFLOAT(I)
   ISN 0008           S=0.0D0
   ISN 0009           DO 30 IR=1,NREP
   ISN 0010           DO 20 I=1,N
   ISN 0011        20 S=S+X(I)*Y(I)
   ISN 0012        30 CONTINUE
   ISN 0013           WRITE(6,100) S
   ISN 0014       100 FORMAT(' DDOT CHECKSUM ',D22.15)
   ISN 0015           STOP
   ISN 0016           END
