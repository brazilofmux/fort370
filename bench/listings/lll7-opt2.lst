                C     LIVERMORE LOOP 7, EQUATION OF STATE FRAGMENT
   ISN 0002           REAL*8 X(1001),Y(1001),Z(1001),U(1007),Q,R,T,S
   ISN 0003           DATA NREP/100000/
   ISN 0004           N=1000
   ISN 0005           Q=0.5D0
   ISN 0006           R=0.25D0
   ISN 0007           T=0.125D0
   ISN 0008           DO 10 K=1,1007
   ISN 0009        10 U(K)=DFLOAT(K)*1.0D-3
   ISN 0010           DO 15 K=1,1001
   ISN 0011           Y(K)=1.0D0/DFLOAT(K)
   ISN 0012        15 Z(K)=DFLOAT(K)*2.0D-3
   ISN 0013           DO 30 IR=1,NREP
   ISN 0014           DO 20 K=1,N
   ISN 0015           X(K)=U(K)+R*(Z(K)+R*Y(K))+T*(U(K+3)+R*(U(K+2)+R*U(K+1))+
                     1     T*(U(K+6)+Q*(U(K+5)+Q*U(K+4))))
   ISN 0016        20 CONTINUE
   ISN 0017        30 CONTINUE
   ISN 0018           S=0.0D0
   ISN 0019           DO 40 K=1,N
   ISN 0020        40 S=S+X(K)
   ISN 0021           WRITE(6,100) S
   ISN 0022       100 FORMAT(' LLL7 CHECKSUM ',D22.15)
   ISN 0023           STOP
   ISN 0024           END
