                C     LINPACK 100: DGEFA + DGESL WITH THE BLAS, AS DONGARRA WROTE THEM
   ISN 0002           REAL*8 A(101,100),B(100),X(100),RESID,S
   ISN 0003           INTEGER IPVT(100)
   ISN 0004           DATA NREP/1000/
   ISN 0005           N=100
   ISN 0006           LDA=101
   ISN 0007           DO 50 IR=1,NREP
   ISN 0008           CALL MATGEN(A,LDA,N,B)
   ISN 0009           CALL DGEFA(A,LDA,N,IPVT,INFO)
   ISN 0010           CALL DGESL(A,LDA,N,IPVT,B,0)
   ISN 0011        50 CONTINUE
   ISN 0012           S=0.0D0
   ISN 0013           DO 60 I=1,N
   ISN 0014        60 S=S+B(I)
   ISN 0015           WRITE(6,100) INFO,S
   ISN 0016       100 FORMAT(' LINPACK INFO ',I3,' CHECKSUM ',D22.15)
   ISN 0017           STOP
   ISN 0018           END
