   ISN 0002           SUBROUTINE MATGEN(A,LDA,N,B)
   ISN 0003           REAL*8 A(LDA,1),B(1)
   ISN 0004           INIT=1325
   ISN 0005           DO 30 J=1,N
   ISN 0006           DO 20 I=1,N
   ISN 0007           INIT=MOD(3125*INIT,65536)
   ISN 0008           A(I,J)=(DFLOAT(INIT)-32768.0D0)/16384.0D0
   ISN 0009        20 CONTINUE
   ISN 0010        30 CONTINUE
   ISN 0011           DO 35 I=1,N
   ISN 0012        35 B(I)=0.0D0
   ISN 0013           DO 50 J=1,N
   ISN 0014           DO 40 I=1,N
   ISN 0015        40 B(I)=B(I)+A(I,J)
   ISN 0016        50 CONTINUE
   ISN 0017           RETURN
   ISN 0018           END
