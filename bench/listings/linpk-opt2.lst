   ISN 0002           INTEGER FUNCTION IDAMAX(N,DX,INCX)
   ISN 0003           REAL*8 DX(1),DMAX
   ISN 0004           IDAMAX=0
   ISN 0005           IF (N .LT. 1) RETURN
   ISN 0007           IDAMAX=1
   ISN 0008           IF (N .EQ. 1) RETURN
   ISN 0010           DMAX=DABS(DX(1))
   ISN 0011           DO 30 I=2,N
   ISN 0012           IF (DABS(DX(I)) .LE. DMAX) GO TO 30
   ISN 0014           IDAMAX=I
   ISN 0015           DMAX=DABS(DX(I))
   ISN 0016        30 CONTINUE
   ISN 0017           RETURN
   ISN 0018           END
