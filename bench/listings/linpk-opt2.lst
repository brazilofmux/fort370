           COMPILER OPTIONS - NAME=  MAIN,OPT=02,LINECNT=50,SIZE=0000K,
                              SOURCE,EBCDIC,LIST,NODECK,LOAD,MAP,NOEDIT,NOID,NOXREF
   ISN 0002           SUBROUTINE DGEFA(A,LDA,N,IPVT,INFO)
   ISN 0003           INTEGER LDA,N,IPVT(1),INFO
   ISN 0004           REAL*8 A(LDA,1),T
   ISN 0005           INFO=0
   ISN 0006           NM1=N-1
   ISN 0007           IF (NM1 .LT. 1) GO TO 70
   ISN 0009           DO 60 K=1,NM1
   ISN 0010           KP1=K+1
   ISN 0011           L=IDAMAX(N-K+1,A(K,K),1)+K-1
   ISN 0012           IPVT(K)=L
   ISN 0013           IF (A(L,K) .EQ. 0.0D0) GO TO 40
   ISN 0015           IF (L .EQ. K) GO TO 10
   ISN 0017           T=A(L,K)
   ISN 0018           A(L,K)=A(K,K)
   ISN 0019           A(K,K)=T
   ISN 0020        10 CONTINUE
   ISN 0021           T=-1.0D0/A(K,K)
   ISN 0022           CALL DSCAL(N-K,T,A(K+1,K),1)
   ISN 0023           DO 30 J=KP1,N
   ISN 0024           T=A(L,J)
   ISN 0025           IF (L .EQ. K) GO TO 20
   ISN 0027           A(L,J)=A(K,J)
   ISN 0028           A(K,J)=T
   ISN 0029        20 CONTINUE
   ISN 0030           CALL DAXPY(N-K,T,A(K+1,K),1,A(K+1,J),1)
   ISN 0031        30 CONTINUE
   ISN 0032           GO TO 50
   ISN 0033        40 CONTINUE
   ISN 0034           INFO=K
   ISN 0035        50 CONTINUE
   ISN 0036        60 CONTINUE
   ISN 0037        70 CONTINUE
   ISN 0038           IPVT(N)=N
   ISN 0039           IF (A(N,N) .EQ. 0.0D0) INFO=N
   ISN 0041           RETURN
   ISN 0042           END

