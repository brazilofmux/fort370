           COMPILER OPTIONS - NAME=  MAIN,OPT=02,LINECNT=50,SIZE=0000K,
                              SOURCE,EBCDIC,LIST,NODECK,LOAD,MAP,NOEDIT,NOID,NOXREF
   ISN 0002           SUBROUTINE DGESL(A,LDA,N,IPVT,B,JOB)
   ISN 0003           INTEGER LDA,N,IPVT(1),JOB
   ISN 0004           REAL*8 A(LDA,1),B(1),T
   ISN 0005           NM1=N-1
   ISN 0006           IF (NM1 .LT. 1) GO TO 30
   ISN 0008           DO 20 K=1,NM1
   ISN 0009           L=IPVT(K)
   ISN 0010           T=B(L)
   ISN 0011           IF (L .EQ. K) GO TO 10
   ISN 0013           B(L)=B(K)
   ISN 0014           B(K)=T
   ISN 0015        10 CONTINUE
   ISN 0016           CALL DAXPY(N-K,T,A(K+1,K),1,B(K+1),1)
   ISN 0017        20 CONTINUE
   ISN 0018        30 CONTINUE
   ISN 0019           DO 40 KB=1,N
   ISN 0020           K=N+1-KB
   ISN 0021           B(K)=B(K)/A(K,K)
   ISN 0022           T=-B(K)
   ISN 0023           CALL DAXPY(K-1,T,A(1,K),1,B(1),1)
   ISN 0024        40 CONTINUE
   ISN 0025           RETURN
   ISN 0026           END
