                C     LIVERMORE LOOP 1, HYDRO FRAGMENT, N=1000, NREP TIMES
   ISN 0002           REAL*8 X(1001),Y(1001),Z(1012),Q,R,T,S
   ISN 0003           DATA NREP/200000/
   ISN 0004           N=1000
   ISN 0005           Q=0.5D0
   ISN 0006           R=0.25D0
   ISN 0007           T=0.125D0
   ISN 0008           DO 10 K=1,1012
   ISN 0009        10 Z(K)=DFLOAT(K)*1.0D-3
   ISN 0010           DO 15 K=1,N
   ISN 0011        15 Y(K)=1.0D0/DFLOAT(K)
   ISN 0012           DO 30 IR=1,NREP
   ISN 0013           DO 20 K=1,N
   ISN 0014        20 X(K)=Q+Y(K)*(R*Z(K+10)+T*Z(K+11))
   ISN 0015        30 CONTINUE
   ISN 0016           S=0.0D0
   ISN 0017           DO 40 K=1,N
   ISN 0018        40 S=S+X(K)
   ISN 0019           WRITE(6,100) S
   ISN 0020       100 FORMAT(' LLL1 CHECKSUM ',D22.15)
   ISN 0021           STOP
   ISN 0022           END
