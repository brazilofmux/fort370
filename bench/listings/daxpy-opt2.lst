                              SOURCE,EBCDIC,LIST,NODECK,LOAD,MAP,NOEDIT,NOID,NOXREF
                C     DAXPY KERNEL: Y = Y + A*X, N=1000, NREP TIMES
   ISN 0002           REAL*8 X(1000),Y(1000),A,S
   ISN 0003           DATA NREP/200000/
   ISN 0004           N=1000
   ISN 0005           A=1.0D-6
   ISN 0006           DO 10 I=1,N
   ISN 0007           X(I)=DFLOAT(I)
   ISN 0008        10 Y(I)=0.0D0
   ISN 0009           DO 30 IR=1,NREP
   ISN 0010           DO 20 I=1,N
   ISN 0011        20 Y(I)=Y(I)+A*X(I)
   ISN 0012        30 CONTINUE
   ISN 0013           S=0.0D0
   ISN 0014           DO 40 I=1,N
   ISN 0015        40 S=S+Y(I)
   ISN 0016           WRITE(6,100) S
   ISN 0017       100 FORMAT(' DAXPY CHECKSUM ',D22.15)
   ISN 0018           STOP
   ISN 0019           END
